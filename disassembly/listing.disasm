3165:          			xReturn = taskSCHEDULER_NOT_STARTED;
3166:          		}
3167:          		else
3168:          		{
3169:          			if( uxSchedulerSuspended == ( UBaseType_t ) pdFALSE )
3170:          			{
3171:          				xReturn = taskSCHEDULER_RUNNING;
3172:          			}
3173:          			else
3174:          			{
3175:          				xReturn = taskSCHEDULER_SUSPENDED;
3176:          			}
3177:          		}
3178:          
3179:          		return xReturn;
3180:          	}
