0010  AA9E     BTFSS PIR1, 5, ACCESS
0012  D002     BRA 0x18
555:           	{
556:           		_asm
557:           			goto vSerialRxISR
0014  EFC0     GOTO 0x3580
0016  F01A     NOP
558:           		_endasm
559:           	}
