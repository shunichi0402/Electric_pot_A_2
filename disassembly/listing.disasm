3378:          #if ( ( configUSE_TRACE_FACILITY == 1 ) && ( configUSE_STATS_FORMATTING_FUNCTIONS == 1 ) )
3379:          
3380:          	void vTaskList( char * pcWriteBuffer )
3381:          	{
3382:          	TaskStatus_t *pxTaskStatusArray;
3383:          	volatile UBaseType_t uxArraySize, x;
3384:          	char cStatus;
3385:          
3386:          		/*
3387:          		 * PLEASE NOTE:
3388:          		 *
3389:          		 * This function is provided for convenience only, and is used by many
3390:          		 * of the demo applications.  Do not consider it to be part of the
3391:          		 * scheduler.
3392:          		 *
3393:          		 * vTaskList() calls uxTaskGetSystemState(), then formats part of the
3394:          		 * uxTaskGetSystemState() output into a human readable table that
3395:          		 * displays task names, states and stack usage.
3396:          		 *
3397:          		 * vTaskList() has a dependency on the sprintf() C library function that
3398:          		 * might bloat the code size, use a lot of stack, and provide different
3399:          		 * results on different platforms.  An alternative, tiny, third party,
3400:          		 * and limited functionality implementation of sprintf() is provided in
3401:          		 * many of the FreeRTOS/Demo sub-directories in a file called
3402:          		 * printf-stdarg.c (note printf-stdarg.c does not provide a full
3403:          		 * snprintf() implementation!).
3404:          		 *
3405:          		 * It is recommended that production systems call uxTaskGetSystemState()
3406:          		 * directly to get access to raw stats data, rather than indirectly
3407:          		 * through a call to vTaskList().
3408:          		 */
3409:          
3410:          
3411:          		/* Make sure the write buffer does not contain a string. */
3412:          		*pcWriteBuffer = 0x00;
3413:          
3414:          		/* Take a snapshot of the number of tasks in case it changes while this
3415:          		function is executing. */
3416:          		uxArraySize = uxCurrentNumberOfTasks;
3417:          
3418:          		/* Allocate an array index for each task. */
3419:          		pxTaskStatusArray = pvPortMalloc( uxCurrentNumberOfTasks * sizeof( TaskStatus_t ) );
3420:          
3421:          		if( pxTaskStatusArray != NULL )
3422:          		{
3423:          			/* Generate the (binary) data. */
3424:          			uxArraySize = uxTaskGetSystemState( pxTaskStatusArray, uxArraySize, NULL );
3425:          
3426:          			/* Create a human readable table from the binary data. */
3427:          			for( x = 0; x < uxArraySize; x++ )
3428:          			{
3429:          				switch( pxTaskStatusArray[ x ].eCurrentState )
3430:          				{
3431:          				case eReady:		cStatus = tskREADY_CHAR;
3432:          									break;
3433:          
3434:          				case eBlocked:		cStatus = tskBLOCKED_CHAR;
3435:          									break;
3436:          
3437:          				case eSuspended:	cStatus = tskSUSPENDED_CHAR;
3438:          									break;
3439:          
3440:          				case eDeleted:		cStatus = tskDELETED_CHAR;
3441:          									break;
3442:          
3443:          				default:			/* Should not get here, but it is included
3444:          									to prevent static checking errors. */
3445:          									cStatus = 0x00;
3446:          									break;
3447:          				}
3448:          
3449:          				sprintf( pcWriteBuffer, "%s\t\t%c\t%u\t%u\t%u\r\n", pxTaskStatusArray[ x ].pcTaskName, cStatus, ( unsigned int ) pxTaskStatusArray[ x ].uxCurrentPriority, ( unsigned int ) pxTaskStatusArray[ x ].usStackHighWaterMark, ( unsigned int ) pxTaskStatusArray[ x ].xTaskNumber );
3450:          				pcWriteBuffer += strlen( pcWriteBuffer );
3451:          			}
3452:          
3453:          			/* Free the array again. */
3454:          			vPortFree( pxTaskStatusArray );
3455:          		}
3456:          		else
3457:          		{
3458:          			mtCOVERAGE_TEST_MARKER();
3459:          		}
3460:          	}
3461:          
3462:          #endif /* ( ( configUSE_TRACE_FACILITY == 1 ) && ( configUSE_STATS_FORMATTING_FUNCTIONS == 1 ) ) */
