3600:          	void *pvTaskIncrementMutexHeldCount( void )
3601:          	{
3602:          		/* If xSemaphoreCreateMutex() is called before any tasks have been created
3603:          		then pxCurrentTCB will be NULL. */
3604:          		if( pxCurrentTCB != NULL )
3605:          		{
3606:          			( pxCurrentTCB->uxMutexesHeld )++;
3607:          		}
3608:          
3609:          		return pxCurrentTCB;
