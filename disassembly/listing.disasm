2960:          
2961:          	static UBaseType_t prvListTaskWithinSingleList( TaskStatus_t *pxTaskStatusArray, List_t *pxList, eTaskState eState )
2962:          	{
2963:          	volatile TCB_t *pxNextTCB, *pxFirstTCB;
2964:          	UBaseType_t uxTask = 0;
2965:          
2966:          		if( listCURRENT_LIST_LENGTH( pxList ) > ( UBaseType_t ) 0 )
2967:          		{
2968:          			listGET_OWNER_OF_NEXT_ENTRY( pxFirstTCB, pxList );
2969:          
2970:          			/* Populate an TaskStatus_t structure within the
2971:          			pxTaskStatusArray array for each task that is referenced from
2972:          			pxList.  See the definition of TaskStatus_t in task.h for the
2973:          			meaning of each TaskStatus_t structure member. */
2974:          			do
2975:          			{
2976:          				listGET_OWNER_OF_NEXT_ENTRY( pxNextTCB, pxList );
2977:          
2978:          				pxTaskStatusArray[ uxTask ].xHandle = ( TaskHandle_t ) pxNextTCB;
2979:          				pxTaskStatusArray[ uxTask ].pcTaskName = ( const char * ) &( pxNextTCB->pcTaskName [ 0 ] );
2980:          				pxTaskStatusArray[ uxTask ].xTaskNumber = pxNextTCB->uxTCBNumber;
2981:          				pxTaskStatusArray[ uxTask ].eCurrentState = eState;
2982:          				pxTaskStatusArray[ uxTask ].uxCurrentPriority = pxNextTCB->uxPriority;
2983:          
2984:          				#if ( INCLUDE_vTaskSuspend == 1 )
2985:          				{
2986:          					/* If the task is in the suspended list then there is a chance
2987:          					it is actually just blocked indefinitely - so really it should
2988:          					be reported as being in the Blocked state. */
2989:          					if( eState == eSuspended )
2990:          					{
2991:          						if( listLIST_ITEM_CONTAINER( &( pxNextTCB->xEventListItem ) ) != NULL )
2992:          						{
2993:          							pxTaskStatusArray[ uxTask ].eCurrentState = eBlocked;
2994:          						}
2995:          					}
2996:          				}
2997:          				#endif /* INCLUDE_vTaskSuspend */
2998:          
2999:          				#if ( configUSE_MUTEXES == 1 )
3000:          				{
3001:          					pxTaskStatusArray[ uxTask ].uxBasePriority = pxNextTCB->uxBasePriority;
3002:          				}
3003:          				#else
3004:          				{
3005:          					pxTaskStatusArray[ uxTask ].uxBasePriority = 0;
3006:          				}
3007:          				#endif
3008:          
3009:          				#if ( configGENERATE_RUN_TIME_STATS == 1 )
3010:          				{
3011:          					pxTaskStatusArray[ uxTask ].ulRunTimeCounter = pxNextTCB->ulRunTimeCounter;
3012:          				}
3013:          				#else
3014:          				{
3015:          					pxTaskStatusArray[ uxTask ].ulRunTimeCounter = 0;
3016:          				}
3017:          				#endif
3018:          
3019:          				#if ( portSTACK_GROWTH > 0 )
3020:          				{
3021:          					pxTaskStatusArray[ uxTask ].usStackHighWaterMark = prvTaskCheckFreeStackSpace( ( uint8_t * ) pxNextTCB->pxEndOfStack );
3022:          				}
3023:          				#else
3024:          				{
3025:          					pxTaskStatusArray[ uxTask ].usStackHighWaterMark = prvTaskCheckFreeStackSpace( ( uint8_t * ) pxNextTCB->pxStack );
3026:          				}
3027:          				#endif
3028:          
3029:          				uxTask++;
3030:          
3031:          			} while( pxNextTCB != pxFirstTCB );
3032:          		}
3033:          		else
3034:          		{
3035:          			mtCOVERAGE_TEST_MARKER();
3036:          		}
3037:          
3038:          		return uxTask;
3039:          	}
