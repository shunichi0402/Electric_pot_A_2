3184:          
3185:          #if ( configUSE_MUTEXES == 1 )
3186:          
3187:          	void vTaskPriorityInherit( TaskHandle_t const pxMutexHolder )
3188:          	{
3189:          	TCB_t * const pxTCB = ( TCB_t * ) pxMutexHolder;
3190:          
3191:          		/* If the mutex was given back by an interrupt while the queue was
3192:          		locked then the mutex holder might now be NULL. */
3193:          		if( pxMutexHolder != NULL )
3194:          		{
3195:          			if( pxTCB->uxPriority < pxCurrentTCB->uxPriority )
3196:          			{
3197:          				/* Adjust the mutex holder state to account for its new
3198:          				priority.  Only reset the event list item value if the value is
3199:          				not	being used for anything else. */
3200:          				if( ( listGET_LIST_ITEM_VALUE( &( pxTCB->xEventListItem ) ) & taskEVENT_LIST_ITEM_VALUE_IN_USE ) == 0UL )
3201:          				{
3202:          					listSET_LIST_ITEM_VALUE( &( pxTCB->xEventListItem ), ( TickType_t ) configMAX_PRIORITIES - ( TickType_t ) pxCurrentTCB->uxPriority ); /*lint !e961 MISRA exception as the casts are only redundant for some ports. */
3203:          				}
3204:          				else
3205:          				{
3206:          					mtCOVERAGE_TEST_MARKER();
3207:          				}
3208:          
3209:          				/* If the task being modified is in the ready state it will need to
3210:          				be moved into a new list. */
3211:          				if( listIS_CONTAINED_WITHIN( &( pxReadyTasksLists[ pxTCB->uxPriority ] ), &( pxTCB->xGenericListItem ) ) != pdFALSE )
3212:          				{
3213:          					if( uxListRemove( &( pxTCB->xGenericListItem ) ) == ( UBaseType_t ) 0 )
3214:          					{
3215:          						taskRESET_READY_PRIORITY( pxTCB->uxPriority );
3216:          					}
3217:          					else
3218:          					{
3219:          						mtCOVERAGE_TEST_MARKER();
3220:          					}
3221:          
3222:          					/* Inherit the priority before being moved into the new list. */
3223:          					pxTCB->uxPriority = pxCurrentTCB->uxPriority;
3224:          					prvAddTaskToReadyList( pxTCB );
3225:          				}
3226:          				else
3227:          				{
3228:          					/* Just inherit the priority. */
3229:          					pxTCB->uxPriority = pxCurrentTCB->uxPriority;
3230:          				}
3231:          
3232:          				traceTASK_PRIORITY_INHERIT( pxTCB, pxCurrentTCB->uxPriority );
3233:          			}
3234:          			else
3235:          			{
3236:          				mtCOVERAGE_TEST_MARKER();
3237:          			}
3238:          		}
3239:          		else
3240:          		{
3241:          			mtCOVERAGE_TEST_MARKER();
3242:          		}
3243:          	}
3244:          
3245:          #endif /* configUSE_MUTEXES */
