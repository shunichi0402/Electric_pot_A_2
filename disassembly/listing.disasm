214:           //--------------------------------------------------------------------------
215:           // DS2428 Detect routine that sets the I2C address and then performs a
216:           // device reset followed by writing the configuration byte to default values:
217:           //   1-Wire speed (c1WS) = standard (0)
218:           //   Strong pull-up (cSPU) = off (0)
219:           //   Presence pulse masking (cPPM) = off (0)
220:           //   Active pull-up (cAPU) = on (CONFIG_APU = 0x01)
221:           //
222:           // Returns: TRUE if device was detected and written
223:           //          FALSE device not detected or failure to write configuration byte
224:           //
225:           int DS2482_detect(unsigned char addr)
