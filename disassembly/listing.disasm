3044:          #if ( ( configUSE_TRACE_FACILITY == 1 ) || ( INCLUDE_uxTaskGetStackHighWaterMark == 1 ) )
3045:          
3046:          	static uint16_t prvTaskCheckFreeStackSpace( const uint8_t * pucStackByte )
3047:          	{
3048:          	uint32_t ulCount = 0U;
3049:          
3050:          		while( *pucStackByte == ( uint8_t ) tskSTACK_FILL_BYTE )
3051:          		{
3052:          			pucStackByte -= portSTACK_GROWTH;
3053:          			ulCount++;
3054:          		}
3055:          
3056:          		ulCount /= ( uint32_t ) sizeof( StackType_t ); /*lint !e961 Casting is not redundant on smaller architectures. */
3057:          
3058:          		return ( uint16_t ) ulCount;
3059:          	}
3060:          
3061:          #endif /* ( ( configUSE_TRACE_FACILITY == 1 ) || ( INCLUDE_uxTaskGetStackHighWaterMark == 1 ) ) */
