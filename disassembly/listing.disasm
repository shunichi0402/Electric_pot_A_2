3314:          #if ( portCRITICAL_NESTING_IN_TCB == 1 )
3315:          
3316:          	void vTaskEnterCritical( void )
3317:          	{
3318:          		portDISABLE_INTERRUPTS();
3319:          
3320:          		if( xSchedulerRunning != pdFALSE )
3321:          		{
3322:          			( pxCurrentTCB->uxCriticalNesting )++;
3323:          
3324:          			/* This is not the interrupt safe version of the enter critical
3325:          			function so	assert() if it is being called from an interrupt
3326:          			context.  Only API functions that end in "FromISR" can be used in an
3327:          			interrupt.  Only assert if the critical nesting count is 1 to
3328:          			protect against recursive calls if the assert function also uses a
3329:          			critical section. */
3330:          			if( pxCurrentTCB->uxCriticalNesting == 1 )
3331:          			{
3332:          				portASSERT_IF_IN_ISR();
3333:          			}
3334:          
3335:          		}
3336:          		else
3337:          		{
3338:          			mtCOVERAGE_TEST_MARKER();
3339:          		}
3340:          	}
3341:          
3342:          #endif /* portCRITICAL_NESTING_IN_TCB */
3343:          /*-----------------------------------------------------------*/
3344:          
3345:          #if ( portCRITICAL_NESTING_IN_TCB == 1 )
3346:          
3347:          	void vTaskExitCritical( void )
3348:          	{
3349:          		if( xSchedulerRunning != pdFALSE )
3350:          		{
3351:          			if( pxCurrentTCB->uxCriticalNesting > 0U )
3352:          			{
3353:          				( pxCurrentTCB->uxCriticalNesting )--;
3354:          
3355:          				if( pxCurrentTCB->uxCriticalNesting == 0U )
3356:          				{
3357:          					portENABLE_INTERRUPTS();
3358:          				}
3359:          				else
3360:          				{
3361:          					mtCOVERAGE_TEST_MARKER();
3362:          				}
3363:          			}
3364:          			else
3365:          			{
3366:          				mtCOVERAGE_TEST_MARKER();
3367:          			}
3368:          		}
3369:          		else
3370:          		{
3371:          			mtCOVERAGE_TEST_MARKER();
3372:          		}
3373:          	}
3374:          
3375:          #endif /* portCRITICAL_NESTING_IN_TCB */
