870:           //--------------------------------------------------------------------------
871:           // Verify the device with the ROM number in ROM_NO buffer is present.
872:           // Return TRUE  : device verified present
873:           //        FALSE : device not present
874:           //
875:           int OWVerify()
876:           {
877:              unsigned char rom_backup[8];
878:              int i,rslt,ld_backup,ldf_backup,lfd_backup;
879:           
880:              // keep a backup copy of the current state
881:              for (i = 0; i < 8; i++)
882:                 rom_backup[i] = ROM_NO[i];
883:              ld_backup = LastDiscrepancy;
884:              ldf_backup = LastDeviceFlag;
885:              lfd_backup = LastFamilyDiscrepancy;
886:           
887:              // set search to find the same device
888:              LastDiscrepancy = 64;
889:              LastDeviceFlag = FALSE;
890:           
891:              if (OWSearch())
892:              {
893:                 // check if same device found
894:                 rslt = TRUE;
895:                 for (i = 0; i < 8; i++)
896:                 {
897:                    if (rom_backup[i] != ROM_NO[i])
898:                    {
899:                       rslt = FALSE;
900:                       break;
901:                    }
902:                 }
903:              }
904:              else
905:                rslt = FALSE;
906:           
907:              // restore the search state
908:              for (i = 0; i < 8; i++)
909:                 ROM_NO[i] = rom_backup[i];
910:              LastDiscrepancy = ld_backup;
911:              LastDeviceFlag = ldf_backup;
912:              LastFamilyDiscrepancy = lfd_backup;
913:           
914:              // return the result of the verify
915:              return rslt;
916:           }
917:           
918:           #endif
