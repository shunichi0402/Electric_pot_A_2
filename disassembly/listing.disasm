3247:          
3248:          #if ( configUSE_MUTEXES == 1 )
3249:          
3250:          	BaseType_t xTaskPriorityDisinherit( TaskHandle_t const pxMutexHolder )
3251:          	{
3252:          	TCB_t * const pxTCB = ( TCB_t * ) pxMutexHolder;
3253:          	BaseType_t xReturn = pdFALSE;
3254:          
3255:          		if( pxMutexHolder != NULL )
3256:          		{
3257:          			configASSERT( pxTCB->uxMutexesHeld );
3258:          			( pxTCB->uxMutexesHeld )--;
3259:          
3260:          			if( pxTCB->uxPriority != pxTCB->uxBasePriority )
3261:          			{
3262:          				/* Only disinherit if no other mutexes are held. */
3263:          				if( pxTCB->uxMutexesHeld == ( UBaseType_t ) 0 )
3264:          				{
3265:          					/* The holding task must be the running task to be able to give
3266:          					the mutex back.  Remove the holding task from the ready list. */
3267:          					if( uxListRemove( &( pxTCB->xGenericListItem ) ) == ( UBaseType_t ) 0 )
3268:          					{
3269:          						taskRESET_READY_PRIORITY( pxTCB->uxPriority );
3270:          					}
3271:          					else
3272:          					{
3273:          						mtCOVERAGE_TEST_MARKER();
3274:          					}
3275:          
3276:          					/* Disinherit the priority before adding the task into the new
3277:          					ready list. */
3278:          					traceTASK_PRIORITY_DISINHERIT( pxTCB, pxTCB->uxBasePriority );
3279:          					pxTCB->uxPriority = pxTCB->uxBasePriority;
3280:          
3281:          					/* Reset the event list item value.  It cannot be in use for
3282:          					any other purpose if this task is running, and it must be
3283:          					running to give back the mutex. */
3284:          					listSET_LIST_ITEM_VALUE( &( pxTCB->xEventListItem ), ( TickType_t ) configMAX_PRIORITIES - ( TickType_t ) pxTCB->uxPriority ); /*lint !e961 MISRA exception as the casts are only redundant for some ports. */
