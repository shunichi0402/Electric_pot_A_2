3478:          
3479:          		/*
3480:          		 * PLEASE NOTE:
3481:          		 *
3482:          		 * This function is provided for convenience only, and is used by many
3483:          		 * of the demo applications.  Do not consider it to be part of the
3484:          		 * scheduler.
3485:          		 *
3486:          		 * vTaskGetRunTimeStats() calls uxTaskGetSystemState(), then formats part
3487:          		 * of the uxTaskGetSystemState() output into a human readable table that
3488:          		 * displays the amount of time each task has spent in the Running state
3489:          		 * in both absolute and percentage terms.
3490:          		 *
3491:          		 * vTaskGetRunTimeStats() has a dependency on the sprintf() C library
3492:          		 * function that might bloat the code size, use a lot of stack, and
3493:          		 * provide different results on different platforms.  An alternative,
3494:          		 * tiny, third party, and limited functionality implementation of
3495:          		 * sprintf() is provided in many of the FreeRTOS/Demo sub-directories in
3496:          		 * a file called printf-stdarg.c (note printf-stdarg.c does not provide
3497:          		 * a full snprintf() implementation!).
3498:          		 *
3499:          		 * It is recommended that production systems call uxTaskGetSystemState()
3500:          		 * directly to get access to raw stats data, rather than indirectly
3501:          		 * through a call to vTaskGetRunTimeStats().
3502:          		 */
3503:          
3504:          		/* Make sure the write buffer does not contain a string. */
3505:          		*pcWriteBuffer = 0x00;
3506:          
3507:          		/* Take a snapshot of the number of tasks in case it changes while this
3508:          		function is executing. */
3509:          		uxArraySize = uxCurrentNumberOfTasks;
3510:          
3511:          		/* Allocate an array index for each task. */
3512:          		pxTaskStatusArray = pvPortMalloc( uxCurrentNumberOfTasks * sizeof( TaskStatus_t ) );
3513:          
3514:          		if( pxTaskStatusArray != NULL )
3515:          		{
3516:          			/* Generate the (binary) data. */
3517:          			uxArraySize = uxTaskGetSystemState( pxTaskStatusArray, uxArraySize, &ulTotalTime );
3518:          
3519:          			/* For percentage calculations. */
3520:          			ulTotalTime /= 100UL;
3521:          
3522:          			/* Avoid divide by zero errors. */
3523:          			if( ulTotalTime > 0 )
3524:          			{
3525:          				/* Create a human readable table from the binary data. */
3526:          				for( x = 0; x < uxArraySize; x++ )
3527:          				{
3528:          					/* What percentage of the total run time has the task used?
3529:          					This will always be rounded down to the nearest integer.
3530:          					ulTotalRunTimeDiv100 has already been divided by 100. */
3531:          					ulStatsAsPercentage = pxTaskStatusArray[ x ].ulRunTimeCounter / ulTotalTime;
3532:          
3533:          					if( ulStatsAsPercentage > 0UL )
3534:          					{
3535:          						#ifdef portLU_PRINTF_SPECIFIER_REQUIRED
3536:          						{
3537:          							sprintf( pcWriteBuffer, "%s\t\t%lu\t\t%lu%%\r\n", pxTaskStatusArray[ x ].pcTaskName, pxTaskStatusArray[ x ].ulRunTimeCounter, ulStatsAsPercentage );
3538:          						}
3539:          						#else
3540:          						{
3541:          							/* sizeof( int ) == sizeof( long ) so a smaller
3542:          							printf() library can be used. */
3543:          							sprintf( pcWriteBuffer, "%s\t\t%u\t\t%u%%\r\n", pxTaskStatusArray[ x ].pcTaskName, ( unsigned int ) pxTaskStatusArray[ x ].ulRunTimeCounter, ( unsigned int ) ulStatsAsPercentage );
3544:          						}
3545:          						#endif
3546:          					}
3547:          					else
3548:          					{
3549:          						/* If the percentage is zero here then the task has
3550:          						consumed less than 1% of the total run time. */
3551:          						#ifdef portLU_PRINTF_SPECIFIER_REQUIRED
3552:          						{
3553:          							sprintf( pcWriteBuffer, "%s\t\t%lu\t\t<1%%\r\n", pxTaskStatusArray[ x ].pcTaskName, pxTaskStatusArray[ x ].ulRunTimeCounter );
3554:          						}
3555:          						#else
3556:          						{
3557:          							/* sizeof( int ) == sizeof( long ) so a smaller
3558:          							printf() library can be used. */
3559:          							sprintf( pcWriteBuffer, "%s\t\t%u\t\t<1%%\r\n", pxTaskStatusArray[ x ].pcTaskName, ( unsigned int ) pxTaskStatusArray[ x ].ulRunTimeCounter );
3560:          						}
3561:          						#endif
3562:          					}
3563:          
3564:          					pcWriteBuffer += strlen( pcWriteBuffer );
3565:          				}
3566:          			}
3567:          			else
3568:          			{
3569:          				mtCOVERAGE_TEST_MARKER();
3570:          			}
3571:          
3572:          			/* Free the array again. */
3573:          			vPortFree( pxTaskStatusArray );
3574:          		}
3575:          		else
3576:          		{
3577:          			mtCOVERAGE_TEST_MARKER();
3578:          		}
3579:          	}
3580:          
3581:          #endif /* ( ( configGENERATE_RUN_TIME_STATS == 1 ) && ( configUSE_STATS_FORMATTING_FUNCTIONS == 1 ) ) */
