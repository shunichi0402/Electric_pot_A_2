104:           /*-----------------------------------------------------------
105:            * Implementation of functions defined in portable.h for the PIC port.
106:            *----------------------------------------------------------*/
107:           
108:           /* Hardware setup for tick. */
109:           #define portTIMER_FOSC_SCALE			( ( uint32_t ) 4 )
110:           
111:           /* Initial interrupt enable state for newly created tasks.  This value is
112:           copied into INTCON when a task switches in for the first time. */
113:           #define portINITAL_INTERRUPT_STATE			0xc0
114:           
115:           /* Just the bit within INTCON for the global interrupt flag. */
116:           #define portGLOBAL_INTERRUPT_FLAG			0x80
117:           
118:           /* Constant used for context switch macro when we require the interrupt 
119:           enable state to be unchanged when the interrupted task is switched back in. */
120:           #define portINTERRUPTS_UNCHANGED			0x00
121:           
122:           /* Some memory areas get saved as part of the task context.  These memory
123:           area's get used by the compiler for temporary storage, especially when 
124:           performing mathematical operations, or when using 32bit data types.  This
125:           constant defines the size of memory area which must be saved. */
126:           #define portCOMPILER_MANAGED_MEMORY_SIZE	( ( uint8_t ) 0x13 )
127:           
128:           /* We require the address of the pxCurrentTCB variable, but don't want to know
129:           any details of its type. */
130:           typedef void TCB_t;
131:           extern volatile TCB_t * volatile pxCurrentTCB;
132:           
133:           /* IO port constants. */
134:           #define portBIT_SET	( ( uint8_t ) 1 )
135:           #define portBIT_CLEAR	( ( uint8_t ) 0 )
136:           
137:           /*
138:            * The serial port ISR's are defined in serial.c, but are called from portable
139:            * as they use the same vector as the tick ISR.
140:            */
141:           void vSerialTxISR( void );
142:           void vSerialRxISR( void );
143:           
144:           /*
145:            * Perform hardware setup to enable ticks.
146:            */
147:           static void prvSetupTimerInterrupt( void );
148:           
149:           /* 
150:            * ISR to maintain the tick, and perform tick context switches if the
151:            * preemptive scheduler is being used.
152:            */
153:           static void prvTickISR( void );
154:           
155:           /*
156:            * ISR placed on the low priority vector.  This calls the appropriate ISR for
157:            * the actual interrupt.
158:            */
159:           static void prvLowInterrupt( void );
160:           
161:           /* 
162:            * Macro that pushes all the registers that make up the context of a task onto
163:            * the stack, then saves the new top of stack into the TCB.
164:            * 
165:            * If this is called from an ISR then the interrupt enable bits must have been 
166:            * set for the ISR to ever get called.  Therefore we want to save the INTCON
167:            * register with the enable bits forced to be set - and ucForcedInterruptFlags 
168:            * must contain these bit settings.  This means the interrupts will again be
169:            * enabled when the interrupted task is switched back in.
170:            *
171:            * If this is called from a manual context switch (i.e. from a call to yield),
172:            * then we want to save the INTCON so it is restored with its current state,
173:            * and ucForcedInterruptFlags must be 0.  This allows a yield from within
174:            * a critical section.
175:            *
176:            * The compiler uses some locations at the bottom of the memory for temporary
177:            * storage during math and other computations.  This is especially true if
178:            * 32bit data types are utilised (as they are by the scheduler).  The .tmpdata
179:            * and MATH_DATA sections have to be stored in there entirety as part of a task
180:            * context.  This macro stores from data address 0x00 to 
181:            * portCOMPILER_MANAGED_MEMORY_SIZE.  This is sufficient for the demo 
182:            * applications but you should check the map file for your project to ensure 
183:            * this is sufficient for your needs.  It is not clear whether this size is 
184:            * fixed for all compilations or has the potential to be program specific.
185:            */
186:           #define	portSAVE_CONTEXT( ucForcedInterruptFlags )      \
187:           {                                                       \
188:                   _asm                                            \
189:                       MOVFF	WREG, PREINC1                   \
190:                       MOVFF       STATUS, PREINC1                 \
191:                       MOVFF	INTCON, WREG                    \
192:                       IORLW	ucForcedInterruptFlags          \
193:                       MOVFF	WREG, PREINC1                   \
194:                   _endasm                                         \
195:           	portDISABLE_INTERRUPTS();                       \
196:                   _asm                                            \
197:                       MOVFF	BSR, PREINC1                    \
198:                       MOVFF	FSR2L, PREINC1                  \
199:                       MOVFF	FSR2H, PREINC1                  \
200:                       MOVFF	FSR0L, PREINC1                  \
201:                       MOVFF	FSR0H, PREINC1                  \
202:                       MOVFF	TABLAT, PREINC1                 \
203:                       MOVFF	TBLPTRU, PREINC1                \
204:                       MOVFF	TBLPTRH, PREINC1                \
205:                       MOVFF	TBLPTRL, PREINC1                \
206:                       MOVFF	PRODH, PREINC1                  \
207:                       MOVFF	PRODL, PREINC1                  \
208:                       MOVFF	PCLATU, PREINC1                 \
209:                       MOVFF	PCLATH, PREINC1                 \
210:                       CLRF	FSR0L, 0                        \
211:                       CLRF	FSR0H, 0                        \
212:                       MOVFF	POSTINC0, PREINC1               \
213:                       MOVFF	POSTINC0, PREINC1               \
214:                       MOVFF	POSTINC0, PREINC1               \
215:                       MOVFF	POSTINC0, PREINC1               \
216:                       MOVFF	POSTINC0, PREINC1               \
217:                       MOVFF	POSTINC0, PREINC1               \
218:                       MOVFF	POSTINC0, PREINC1               \
219:                       MOVFF	POSTINC0, PREINC1               \
220:                       MOVFF	POSTINC0, PREINC1               \
221:                       MOVFF	POSTINC0, PREINC1               \
222:                       MOVFF	POSTINC0, PREINC1               \
223:                       MOVFF	POSTINC0, PREINC1               \
224:                       MOVFF	POSTINC0, PREINC1               \
225:                       MOVFF	POSTINC0, PREINC1               \
226:                       MOVFF	POSTINC0, PREINC1               \
227:                       MOVFF	POSTINC0, PREINC1               \
228:                       MOVFF	POSTINC0, PREINC1               \
229:                       MOVFF	POSTINC0, PREINC1               \
230:                       MOVFF	POSTINC0, PREINC1               \
231:                       MOVFF	INDF0, PREINC1                  \
232:                       MOVFF	FSR0L, PREINC1                  \
233:                       MOVFF	FSR0H, PREINC1                  \
234:                       MOVFF	STKPTR, FSR0L                   \
235:                   _endasm                                         \
236:                   while( STKPTR > ( uint8_t ) 0 )                 \
237:                   {                                               \
238:                       _asm                                        \
239:                           MOVFF	TOSL, PREINC1                   \
240:                           MOVFF	TOSH, PREINC1                   \
241:                           MOVFF	TOSU, PREINC1                   \
242:                           POP                                     \
243:                       _endasm                                     \
244:                   }                                               \
245:                   _asm                                            \
246:                       MOVFF	FSR0L, PREINC1                  \
247:                       MOVF	PREINC1, 1, 0                   \
248:                       MOVFF	pxCurrentTCB, FSR0L             \
249:                       MOVFF	pxCurrentTCB + 1, FSR0H         \
250:                       MOVFF	FSR1L, POSTINC0                 \
251:                       MOVFF	FSR1H, POSTINC0                 \
252:                   _endasm                                         \
253:           }
254:           /*-----------------------------------------------------------*/
255:           
256:           
257:           /*
258:            * This is the reverse of portSAVE_CONTEXT.  See portSAVE_CONTEXT for more
259:            * details.
260:            */
261:           #define portRESTORE_CONTEXT()													\
262:           {																				\
263:           	_asm																		\
264:           		/* Set FSR0 to point to pxCurrentTCB->pxTopOfStack. */					\
265:           		MOVFF	pxCurrentTCB, FSR0L												\
266:           		MOVFF	pxCurrentTCB + 1, FSR0H											\
267:           																				\
268:           		/* De-reference FSR0 to set the address it holds into FSR1.				\
269:           		(i.e. *( pxCurrentTCB->pxTopOfStack ) ). */								\
270:           		MOVFF	POSTINC0, FSR1L													\
271:           		MOVFF	POSTINC0, FSR1H													\
272:           																				\
273:           		/* How many return addresses are there on the hardware stack?  Discard	\
274:           		the first byte as we are pointing to the next free space. */			\
275:           		MOVFF	POSTDEC1, FSR0L													\
276:           		MOVFF	POSTDEC1, FSR0L													\
277:           	_endasm																		\
278:           																				\
279:           	/* Fill the hardware stack from our software stack. */						\
280:           	STKPTR = 0;																	\
281:           																				\
282:           	while( STKPTR < FSR0L )														\
283:           	{																			\
284:           		_asm																	\
285:           			PUSH																\
286:           			MOVF	POSTDEC1, 0, 0												\
287:           			MOVWF	TOSU, 0														\
288:           			MOVF	POSTDEC1, 0, 0												\
289:           			MOVWF	TOSH, 0														\
290:           			MOVF	POSTDEC1, 0, 0												\
291:           			MOVWF	TOSL, 0														\
292:           		_endasm																	\
293:           	}																			\
294:           																				\
295:           	_asm																		\
296:           		/* Restore the .tmpdata and MATH_DATA memory. */						\
297:           		MOVFF	POSTDEC1, FSR0H													\
298:           		MOVFF	POSTDEC1, FSR0L													\
299:           		MOVFF	POSTDEC1, POSTDEC0												\
300:           		MOVFF	POSTDEC1, POSTDEC0												\
301:           		MOVFF	POSTDEC1, POSTDEC0												\
302:           		MOVFF	POSTDEC1, POSTDEC0												\
303:           		MOVFF	POSTDEC1, POSTDEC0												\
304:           		MOVFF	POSTDEC1, POSTDEC0												\
305:           		MOVFF	POSTDEC1, POSTDEC0												\
306:           		MOVFF	POSTDEC1, POSTDEC0												\
307:           		MOVFF	POSTDEC1, POSTDEC0												\
308:           		MOVFF	POSTDEC1, POSTDEC0												\
309:           		MOVFF	POSTDEC1, POSTDEC0												\
310:           		MOVFF	POSTDEC1, POSTDEC0												\
311:           		MOVFF	POSTDEC1, POSTDEC0												\
312:           		MOVFF	POSTDEC1, POSTDEC0												\
313:           		MOVFF	POSTDEC1, POSTDEC0												\
314:           		MOVFF	POSTDEC1, POSTDEC0												\
315:           		MOVFF	POSTDEC1, POSTDEC0												\
316:           		MOVFF	POSTDEC1, POSTDEC0												\
317:           		MOVFF	POSTDEC1, POSTDEC0												\
318:           		MOVFF	POSTDEC1, INDF0													\
319:           		/* Restore the other registers forming the tasks context. */			\
320:           		MOVFF	POSTDEC1, PCLATH												\
321:           		MOVFF	POSTDEC1, PCLATU												\
322:           		MOVFF	POSTDEC1, PRODL													\
323:           		MOVFF	POSTDEC1, PRODH													\
324:           		MOVFF	POSTDEC1, TBLPTRL												\
325:           		MOVFF	POSTDEC1, TBLPTRH												\
326:           		MOVFF	POSTDEC1, TBLPTRU												\
327:           		MOVFF	POSTDEC1, TABLAT												\
328:           		MOVFF	POSTDEC1, FSR0H													\
329:           		MOVFF	POSTDEC1, FSR0L													\
330:           		MOVFF	POSTDEC1, FSR2H													\
331:           		MOVFF	POSTDEC1, FSR2L													\
332:           		MOVFF	POSTDEC1, BSR													\
333:           		/* The next byte is the INTCON register.  Read this into WREG as some	\
334:           		manipulation is required. */											\
335:           		MOVFF	POSTDEC1, WREG													\
336:           	_endasm																		\
337:           																				\
338:           	/* From the INTCON register, only the interrupt enable bits form part		\
339:           	of the tasks context.  It is perfectly legitimate for another task to		\
340:           	have modified any other bits.  We therefore only restore the top two bits.	\
341:           	*/																			\
342:           	if( WREG & portGLOBAL_INTERRUPT_FLAG )										\
343:           	{																			\
344:           		_asm 																	\
345:           			MOVFF	POSTDEC1, STATUS											\
346:           			MOVFF	POSTDEC1, WREG												\
347:           			/* Return enabling interrupts. */									\
348:           			RETFIE	0															\
349:           		_endasm																	\
350:           	}																			\
351:           	else																		\
352:           	{																			\
353:           		_asm 																	\
354:           			MOVFF	POSTDEC1, STATUS											\
355:           			MOVFF	POSTDEC1, WREG												\
356:           			/* Return without effecting interrupts.  The context may have		\
357:           			been saved from a critical region. */								\
358:           			RETURN	0															\
359:           		_endasm																	\
360:           	}																			\
361:           }
