1242:          
1243:          //--------------------------------------------------------------------------
1244:          // Load the CMOD driver and get a pointers to the functions
1245:          //
1246:          int LoadCMOD(void)
1247:          {
1248:             // attempt to get a SHandle to the TMEX driver
1249:             hInst = LoadLibrary(L"CMODCOMM.DLL");
1250:          
1251:             // get a pointer to the function needed by loopit32
1252:             if (hInst != NULL)
1253:             {
1254:                CmodBoardConnect = GetProcAddress(hInst,"CmodBoardConnect");
1255:                if (CmodBoardConnect == NULL) printf("could not find CmodBoardConnect\n"); //????
1256:                CmodBoardConnected = GetProcAddress(hInst,"CmodBoardConnected");
1257:                if (CmodBoardConnected == NULL) printf("could not find CmodBoardConnected\n"); //????
1258:                CmodBoardDisconnect = GetProcAddress(hInst,"CmodBoardDisconnect");
1259:                if (CmodBoardDisconnect == NULL) printf("could not find CmodBoardDisconnect\n"); //????
1260:                CmodComm2ByteWrite = GetProcAddress(hInst,"CmodComm2ByteWrite");
1261:                if (CmodComm2ByteWrite == NULL) printf("could not find CmodComm2ByteWrite\n"); //????
1262:                CmodCommResultChar = GetProcAddress(hInst,"CmodCommResultChar");
1263:                if (CmodCommResultChar == NULL) printf("could not find CmodCommResultChar\n"); //????
1264:          
1265:                // check to make sure got ALL of the functions needed
1266:                if ((CmodBoardConnect == NULL) || (CmodBoardConnected == NULL) ||
1267:                   (CmodBoardDisconnect == NULL) || (CmodComm2ByteWrite == NULL) ||
1268:                   (CmodCommResultChar == NULL))
1269:                {
1270:                   printf("ERROR, could not get a pointer to all"
1271:                          " of the CMOD functions needed\n");
1272:                   return 0;
1273:                }
1274:                return 1;
1275:             }
1276:             else
1277:                return 0;
1278:          }
1279:          
1280:          //--------------------------------------------------------------------------
1281:          // UnLoad the CMOD driver
1282:          //
1283:          void UnLoadCMOD(void)
1284:          {
1285:             // release the TMEX driver
1286:             FreeLibrary(hInst);
1287:          }
1288:          */
