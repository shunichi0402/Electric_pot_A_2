3289:          					multiple mutexes were held and the mutexes were given back
3290:          					in an order different to that in which they were taken. */
3291:          					xReturn = pdTRUE;
3292:          				}
3293:          				else
3294:          				{
3295:          					mtCOVERAGE_TEST_MARKER();
3296:          				}
3297:          			}
3298:          			else
3299:          			{
3300:          				mtCOVERAGE_TEST_MARKER();
3301:          			}
3302:          		}
3303:          		else
