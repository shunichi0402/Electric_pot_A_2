3066:          	UBaseType_t uxTaskGetStackHighWaterMark( TaskHandle_t xTask )
3067:          	{
3068:          	TCB_t *pxTCB;
3069:          	uint8_t *pucEndOfStack;
3070:          	UBaseType_t uxReturn;
3071:          
3072:          		pxTCB = prvGetTCBFromHandle( xTask );
3073:          
3074:          		#if portSTACK_GROWTH < 0
3075:          		{
3076:          			pucEndOfStack = ( uint8_t * ) pxTCB->pxStack;
3077:          		}
3078:          		#else
3079:          		{
3080:          			pucEndOfStack = ( uint8_t * ) pxTCB->pxEndOfStack;
3081:          		}
3082:          		#endif
3083:          
3084:          		uxReturn = ( UBaseType_t ) prvTaskCheckFreeStackSpace( pucEndOfStack );
3085:          
3086:          		return uxReturn;
3087:          	}
3088:          
3089:          #endif /* INCLUDE_uxTaskGetStackHighWaterMark */
